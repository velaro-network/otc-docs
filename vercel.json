{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "retype build && retype build cross-border",
  "outputDirectory": ".retype",
  "installCommand": "npm install",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/otc/",
      "permanent": false
    }
  ]
}
